        <mxCell id="CVoorqUsRGjW697hoiuj-1" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;menu command&lt;/span&gt;&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;:&lt;span style=&quot;-webkit-text-stroke: 0.4px; color: rgb(29, 29, 27); font-size: small; font-weight: bold;&quot;&gt;Exit Commands&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;-webkit-text-stroke-width: 0.4px; color: rgb(29, 29, 27); font-size: small; -webkit-text-stroke-color: initial !important;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;:wq Write file to disk and quit the editor&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;-webkit-text-stroke-width: 0.4px; color: rgb(29, 29, 27); font-size: small; -webkit-text-stroke-color: initial !important;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;:q! Quit (no warning)&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;-webkit-text-stroke-width: 0.4px; color: rgb(29, 29, 27); font-size: small; -webkit-text-stroke-color: initial !important;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;:q Quit (a warning is printed if a modified file has not been saved)&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;-webkit-text-stroke: 0.4px !important;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;File Manipulation Commands&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;-webkit-text-stroke-width: 0.4px; color: rgb(29, 29, 27); font-size: small; -webkit-text-stroke-color: initial !important;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;b style=&quot;-webkit-text-stroke-width: 0.4px; -webkit-text-stroke-color: initial !important;&quot;&gt;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;-webkit-text-stroke-width: 0.4px; color: rgb(29, 29, 27); font-size: small; -webkit-text-stroke-color: initial !important;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;:w Write workspace to original file (save progress to the same file)&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;-webkit-text-stroke-width: 0.4px; color: rgb(29, 29, 27); font-size: small; -webkit-text-stroke-color: initial !important;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;-webkit-text-stroke-width: 0.4px;&quot;&gt;:w file_name Write workspace to named file (save progress to new&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;-webkit-text-stroke-width: 0.4px;&quot;&gt;file_name&lt;/span&gt;&lt;span style=&quot;-webkit-text-stroke-width: 0.4px;&quot;&gt;)&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;-webkit-text-stroke-color: initial !important;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;font size=&quot;2&quot; color=&quot;#1d1d1b&quot;&gt;&lt;span style=&quot;-webkit-text-stroke-width: 0.4px;&quot;&gt;:r&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;color: rgb(29, 29, 27); font-size: small; -webkit-text-stroke-width: 0.4px;&quot;&gt;file_name&amp;nbsp;&lt;/span&gt;&lt;font style=&quot;&quot; size=&quot;2&quot; color=&quot;#1d1d1b&quot;&gt;&lt;span style=&quot;-webkit-text-stroke-width: 0.4px;&quot;&gt;Read contents of a file to the workspace (load progress)&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;-webkit-text-stroke-color: initial !important;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;&quot; size=&quot;2&quot; color=&quot;#1d1d1b&quot;&gt;&lt;span style=&quot;-webkit-text-stroke-width: 0.4px;&quot;&gt;&lt;b&gt;Move snake commands&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;-webkit-text-stroke-color: initial !important;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;h - move cursor left&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;-webkit-text-stroke-color: initial !important;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;j - move cursor down&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;-webkit-text-stroke-color: initial !important;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;k - move cursor up&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;-webkit-text-stroke-color: initial !important;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;l - move cursor right&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
